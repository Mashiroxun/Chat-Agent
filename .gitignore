# ── 依赖与运行时二进制 ──────────────────────────────
node_modules/
runtime/

# ── 用户数据（含 API Key、聊天记录、登录态，绝不入库）──
data/
data-*/
# data.removed-* 是手工挪走的历史数据目录（2026-11-14 排查补丁时产生的）。
# 它是 data 而不是 data-：原来的 `data-*/` 一行匹配不到，导致它一直是未跟踪状态，
# 一次 `git add -A` 就会把 config.json（API Key）、logs、memory 一起推上公开仓库。
data.removed*/
log/
logs/
*.log

# ── 内部工程记录与运行数据（面向人的报告，不入库）──
docs/
.workbuddy/
plugin-data/

# ── 构建产物 ──────────────────────────────────────
dist/
build/
.qa-local/

# ── 手工备份（历史快照，git 里不需要）──────────────
*.bak
*.bak-*
*.before-*
*.orig
# backup/ 是整目录源码快照（含本机路径）。上面几条只匹配文件，匹配不到目录，
# 此前它一直未跟踪，一次 `git add -A` 就会推上公开仓库。
backup/

# ── 系统与临时文件 ────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
__pycache__/
.forge-tmp/
*.tmp
*.crdownload
